{
  "cmake.configureOnOpen": false,
  "cmake.useCMakePresets": "always",
  "cmake.useVsDeveloperEnvironment": "always",
  "cmake.postConfigureTask": "[CGLab] Normalize compile_commands",
  "C_Cpp.exclusionPolicy": "checkFolders",

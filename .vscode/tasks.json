{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "[CGLab] Diagnose environment",
      "type": "process",
      "command": "${workspaceFolder}/scripts/cglab.sh",
      "windows": {
        "command": "${workspaceFolder}/scripts/cglab.cmd"
      },
      "args": ["doctor"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "[CGLab] Normalize compile_commands",
      "type": "process",
      "command": "${workspaceFolder}/scripts/cglab.sh",
      "windows": {
        "command": "${workspaceFolder}/scripts/cglab.cmd"
      },
      "args": ["normalize-ccdb"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "[CGLab] Install vcpkg dependencies",
      "type": "process",
      "command": "${workspaceFolder}/scripts/cglab.sh",
      "windows": {
        "command": "${workspaceFolder}/scripts/cglab.cmd"
      },
      "args": ["deps", "--preset", "${input:toolchainPreset}", "--triplet", "${input:vcpkgTriplet}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "toolchainPreset",
      "type": "pickString",
      "description": "选择用于安装依赖的平台工具链",
      "options": ["windows-msvc-ninja", "linux-clang-ninja"],
      "default": "windows-msvc-ninja"
    },
    {
      "id": "vcpkgTriplet",
      "type": "promptString",
      "description": "vcpkg triplet",
      "default": "x64-windows"
    }
  ]
}

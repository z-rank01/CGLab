{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "cppvsdbg",
      "request": "launch",
      "name": "CGLab Windows: Launch executable with asset",
      "program": "${workspaceFolder}/${input:debugExecutable}",
      "cwd": "${workspaceFolder}",
      "args": ["--asset", "${input:debugAsset}", "--validation"],
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "type": "promptString",
      "id": "debugExecutable",
      "description": "输入相对于工作区的 .exe 路径",
      "default": "build/windows-msvc-ninja/Debug/ShadowSample.exe"
    },
    {
      "type": "promptString",
      "id": "debugAsset",
      "description": "输入 glTF/GLB 资产路径",
      "default": "assets/triangle.gltf"
    }
  ]
}

{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "toolchainFile": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
      }
    },
    {
      "name": "windows-msvc-ninja",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "displayName": "Windows MSVC / Ninja",
      "environment": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "linux-clang-ninja",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "displayName": "Linux Clang / Ninja",
      "environment": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "windows-msvc-ninja-debug",
      "inherits": "windows-msvc-ninja",
      "displayName": "Windows MSVC / Ninja / Debug",
      "binaryDir": "${sourceDir}/build/windows-msvc-ninja/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-msvc-ninja-release",
      "inherits": "windows-msvc-ninja",
      "displayName": "Windows MSVC / Ninja / Release",
      "binaryDir": "${sourceDir}/build/windows-msvc-ninja/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-msvc-ninja-relwithdebinfo",
      "inherits": "windows-msvc-ninja",
      "displayName": "Windows MSVC / Ninja / RelWithDebInfo",
      "binaryDir": "${sourceDir}/build/windows-msvc-ninja/RelWithDebInfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-clang-ninja-debug",
      "inherits": "linux-clang-ninja",
      "displayName": "Linux Clang / Ninja / Debug",
      "binaryDir": "${sourceDir}/build/linux-clang-ninja/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-clang-ninja-release",
      "inherits": "linux-clang-ninja",
      "displayName": "Linux Clang / Ninja / Release",
      "binaryDir": "${sourceDir}/build/linux-clang-ninja/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-clang-ninja-relwithdebinfo",
      "inherits": "linux-clang-ninja",
      "displayName": "Linux Clang / Ninja / RelWithDebInfo",
      "binaryDir": "${sourceDir}/build/linux-clang-ninja/RelWithDebInfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-ninja-debug", "configurePreset": "windows-msvc-ninja-debug" },
    { "name": "windows-msvc-ninja-release", "configurePreset": "windows-msvc-ninja-release" },
    { "name": "windows-msvc-ninja-relwithdebinfo", "configurePreset": "windows-msvc-ninja-relwithdebinfo" },
    { "name": "linux-clang-ninja-debug", "configurePreset": "linux-clang-ninja-debug" },
    { "name": "linux-clang-ninja-release", "configurePreset": "linux-clang-ninja-release" },
    { "name": "linux-clang-ninja-relwithdebinfo", "configurePreset": "linux-clang-ninja-relwithdebinfo" }
  ],
  "testPresets": [
    { "name": "windows-msvc-ninja-debug", "configurePreset": "windows-msvc-ninja-debug", "output": { "outputOnFailure": true } },
    { "name": "windows-msvc-ninja-release", "configurePreset": "windows-msvc-ninja-release", "output": { "outputOnFailure": true } },
    { "name": "windows-msvc-ninja-relwithdebinfo", "configurePreset": "windows-msvc-ninja-relwithdebinfo", "output": { "outputOnFailure": true } },
    { "name": "linux-clang-ninja-debug", "configurePreset": "linux-clang-ninja-debug", "output": { "outputOnFailure": true } },
    { "name": "linux-clang-ninja-release", "configurePreset": "linux-clang-ninja-release", "output": { "outputOnFailure": true } },
    { "name": "linux-clang-ninja-relwithdebinfo", "configurePreset": "linux-clang-ninja-relwithdebinfo", "output": { "outputOnFailure": true } }
  ]
}
